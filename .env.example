# Copy this file to .env and fill in your keys. NEVER commit .env.
# Blank values fall back to the defaults shown in the comments.

# Required. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Without it the agent runs in LIMITED MODE (no web search).
# Get a key at https://app.tavily.com/
TAVILY_API_KEY=

# Gemini model name (default: gemini-3.6-flash)
GEMINI_MODEL=

# Max decide/search loop iterations per question (default: 5, range 1-20)
MAX_AGENT_ITERATIONS=

# Max web searches per question (default: 2, range 0-10; 0 disables search)
MAX_SEARCH_CALLS=

# Max search results passed to the model per search (default: 5, range 1-10)
MAX_SEARCH_RESULTS=

# Max history messages sent to the model (default: 6, range 0-50)
MAX_HISTORY_MESSAGES=

# Max characters allowed in an answer (default: 4000, range 200-20000)
MAX_OUTPUT_LENGTH=

# Timeout in seconds for model and search requests (default: 30, range 1-300)
REQUEST_TIMEOUT_SECONDS=

# DEBUG, INFO, WARNING, ERROR or CRITICAL (default: INFO)
LOG_LEVEL=

# Optional locations (defaults: ./data and ./logs)
DATA_DIR=
LOG_DIR=
